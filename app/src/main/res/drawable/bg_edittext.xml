<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!--
        shape : permet de créer des formes géométriques en XML
        On l'utilise ici pour créer un fond arrondi pour notre EditText
        sans avoir besoin d'une image PNG
    -->

    <!-- Couleur de fond du champ de saisie -->
    <solid android:color="#1E1E3A" />

    <!--
        corners : arrondit les coins du rectangle
        radius="10dp" : degré d'arrondissement des coins
    -->
    <corners android:radius="10dp" />

    <!--
        stroke : bordure autour du champ
        width : épaisseur de la bordure
        color : couleur de la bordure — rouge semi-transparent
    -->
    <stroke
        android:width="1dp"
        android:color="#55E94560" />

</shape>